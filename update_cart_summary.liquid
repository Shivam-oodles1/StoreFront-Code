 * ==========================================
 *
 * Markup is stored PER CART LINE:
 *
 * item.properties._practitioner_markup
 *
 * Example:
 *
 * Product A
 * Base price = $39.99
 * Markup     = $3.00
 *
 * Product B
 * Base price = $2.20
 * Markup     = $2.00
 *
 * Shopify cart total = $42.19
 *
 * Total markup = $5.00
 *
 * Estimated customer total = $47.19
 */
async function updatePractitionerTotal() {




  try {




    /*
     * Get the latest cart.
     */
    const response = await fetch(
      window.Shopify.routes.root + 'cart.js',
      {
        method: 'GET',
        headers: {
          'Accept': 'application/json'
        },
        credentials: 'same-origin',
        cache: 'no-store'
      }
    );




    if (!response.ok) {
      throw new Error(
        'Failed to load cart'
      );
    }




    const cart = await response.json();








    /*
     * ======================================
     * BASE CART TOTAL
     * ======================================
     *
     * Shopify returns money in cents.
     *
     * Example:
     * 4219 = $42.19
     */
    const baseTotal =
      Number(cart.total_price || 0) / 100;








    /*
     * ======================================
     * CALCULATE TOTAL PRACTITIONER MARKUP
     * ======================================
     */
    let totalMarkup = 0;




    if (Array.isArray(cart.items)) {




      cart.items.forEach(function (item) {




        /*
         * Read markup from this specific
         * cart line.
         */
        const markup =
          Number.parseFloat(
            item.properties?._practitioner_markup || '0'
          );








        /*
         * Ignore invalid/negative values.
         */
        if (
          !Number.isFinite(markup) ||
          markup <= 0
        ) {
          return;
        }








        /*
         * Markup is PER UNIT.
         *
         * Example:
         *
         * Quantity = 2
         * Markup   = $3
         *
         * Total markup = $6
         */
        totalMarkup +=
          markup * Number(item.quantity || 0);




      });




    }








    /*
     * ======================================
     * FINAL DISPLAYED TOTAL
     * ======================================
     */
    const finalTotal =
      baseTotal + totalMarkup;








    /*
     * ======================================
     * FIND ESTIMATED TOTAL ELEMENT
     * ======================================
     */
    const totalElement =
      document.getElementById(
        'custom-cart-total'
      );




    if (!totalElement) {




      console.warn(
        '[Practitioner Markup] #custom-cart-total not found'
      );




      return;
    }








    /*
     * ======================================
     * FORMAT AUD
     * ======================================
     */
    totalElement.textContent =
      new Intl.NumberFormat('en-AU', {
        style: 'currency',
        currency: 'AUD'
      }).format(finalTotal);








    /*
     * ======================================
     * DEBUG
     * ======================================
     */
    console.log(
      '[Practitioner Markup] Total calculation:',
      {
        baseTotal,
        totalMarkup,
        finalTotal,
        items: cart.items
      }
    );




  } catch (error) {




    console.error(
      '[Practitioner Markup] Failed to update estimated total:',
      error
    );




  }




}








/*
 * ==========================================
 * INITIALIZE ESTIMATED TOTAL
 * ==========================================
 */
function initializePractitionerTotal() {




  updatePractitionerTotal();




}








if (
  document.readyState === 'loading'
) {




  document.addEventListener(
    'DOMContentLoaded',
    initializePractitionerTotal
  );




} else {




  initializePractitionerTotal();




}








